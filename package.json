{
  "name": "tique",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --go",
    "android": "EXPO_NO_TELEMETRY=1 expo start --go --android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "export:android": "EXPO_NO_TELEMETRY=1 expo export --platform android",
    "native:build": "EXPO_NO_TELEMETRY=1 node scripts/build-capture-poc.mjs",
    "native:test": "EXPO_NO_TELEMETRY=1 node scripts/build-capture-poc.mjs --test-only"
  },
  "dependencies": {
    "decode-uri-component": "file:vendor/decode-uri-component-compat",
    "decode-uri-component-fixed": "npm:decode-uri-component@0.5.1",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component"
  }
}
